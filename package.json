{
  "name": "kakao-hr-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-workshop 'vitest run tests/rules.emulator.test.ts'",
    "check": "npm run test && npm run build && npm --prefix functions run build",
    "test:backend": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-workshop 'vitest run tests/backend.emulator.test.ts'"
  },
  "dependencies": {
    "@fontsource/jua": "^5.2.6",
    "@fontsource/noto-sans-kr": "^5.2.6",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "agent-browser": "^0.21.0",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  }
}
